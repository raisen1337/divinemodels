    "optimize": "bun scripts/optimize.js",
    "fast-start": "bun scripts/fast-start.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "prisma:seed-texts": "ts-node --transpile-only prisma/seedSiteTexts.ts",
    "prisma:seed-privacy-terms": "ts-node --transpile-only prisma/seedPrivacyTermsTexts.ts",
    "import:models": "ts-node --transpile-only scripts/importModels.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.1.1",
    "@prisma/client": "^6.10.1",
    "@types/pg": "^8.15.4",
    "@uploadthing/react": "^7.3.2",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.1",
    "multer": "^2.0.1",
    "next": "15.3.4",
    "next-auth": "^4.24.11",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.59.0",
    "uploadthing": "^7.7.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "prisma": "^6.10.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "@types/bun": "latest"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
